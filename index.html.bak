      const items = CONFIG.whatsappLinks.map(function(item) {
        return '<a class="link-item" href="' + item.url + '" target="_blank" rel="noopener">' +
          '<div class="link-icon-box" style="color:#25d366;">' + svgIcon("whatsapp") + '</div>' +
          '<div class="link-text">' +
            '<div class="link-title">' + item.title + '</div>' +
            '<div class="link-subtitle">' + item.subtitle + '</div>' +
          '</div>' +
          '<div class="link-arrow">' + svgIcon("chevron") + '</div>' +
        '</a>';
      }).join("");

      return '<section class="section" aria-labelledby="whatsapp-heading">' +
        '<div class="section-header">' +
          '<h2 class="section-title" id="whatsapp-heading">' + svgIcon("whatsapp") + ' WhatsApp Clinic Desks</h2>' +
          '<span class="section-subtitle">Instant response</span>' +
        '</div>' +
        '<nav class="links-card" aria-label="WhatsApp clinic desks">' + items + '</nav>' +
