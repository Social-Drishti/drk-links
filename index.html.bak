    function svgIcon(name, extraClass) {
      return '<svg class="' + (extraClass || '') + '" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">' + (ICONS[name] || '') + '</svg>';
    }

