        '</a>';
      }).join("");

      return '<section class="section" aria-labelledby="links-heading">' +
        '<div class="section-header">' +
          '<h2 class="section-title" id="links-heading">' + svgIcon("globe") + ' Official Links & Resources</h2>' +
        '</div>' +
        '<nav class="links-card" aria-label="Important links">' + items + '</nav>' +
      '</section>';
    }

    /* ====================================================================
       Render Google Reviews Card
    ==================================================================== */
    function renderReviews() {
      const r = CONFIG.reviews;
