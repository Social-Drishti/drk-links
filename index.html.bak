    /* ====================================================================
       Render Footer
    ==================================================================== */
    function renderFooter() {
      const year = new Date().getFullYear();
      const text = (CONFIG.footer.text || "").replace("{year}", year);
      return '<div class="footer"><p>' + text + '</p></div>';
    }

    /* ====================================================================
       Initial UI Dynamic Mount
    ==================================================================== */
    function mountApp() {
      if (CONFIG.theme && CONFIG.theme.fontFamily) {
        document.documentElement.style.setProperty('--font', CONFIG.theme.fontFamily);
      }

      document.getElementById("profile-mount").innerHTML = renderProfile();
      document.getElementById("cta-mount").innerHTML = renderCtas();
      document.getElementById("events-mount").innerHTML = renderEventsSection();
      document.getElementById("whatsapp-mount").innerHTML = renderWhatsApp();
      document.getElementById("links-mount").innerHTML = renderLinks();
      document.getElementById("reviews-mount").innerHTML = renderReviews();
      document.getElementById("app-mount").innerHTML = renderApp();
      document.getElementById("clinic-mount").innerHTML = renderClinic();
      document.getElementById("socials-mount").innerHTML = renderSocials();
      document.getElementById("footer-mount").innerHTML = renderFooter();

      bindEventsLogic();
    }

    /* ====================================================================
       Calendar File (.ics) Generator for Events
    ==================================================================== */
    function downloadIcsCalendar(event) {
      if (!event) return;
      const cleanDate = (event.date || "").replace(/-/g, "");
      const startDate = cleanDate ? cleanDate + "T043000Z" : "20261015T043000Z";
      const endDate = cleanDate ? cleanDate + "T073000Z" : "20261015T073000Z";
      const title = event.title || "Spine Health Event";
      const desc = (event.description || "").replace(/\n/g, "\\n");
      const loc = (event.location || "").replace(/,/g, "\\,");

      const icsData = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Dr Rajneesh Kant//Back to Nature Spine Clinic//EN",
        "BEGIN:VEVENT",
        "UID:" + (event.id || "event") + "@drrajneeshkant.com",
        "DTSTAMP:" + cleanDate + "T000000Z",
        "DTSTART:" + startDate,
        "DTEND:" + endDate,
        "SUMMARY:" + title,
        "DESCRIPTION:" + desc,
        "LOCATION:" + loc,
        "END:VEVENT",
        "END:VCALENDAR"
      ].join("\r\n");

      const blob = new Blob([icsData], { type: "text/calendar;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = (event.id || "event") + "-spine-clinic.ics";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    /* ====================================================================
       Modal & Interaction Bindings
    ==================================================================== */
    let lastActiveElement = null;

    function openEventModal(eventId) {
      const event = (CONFIG.events || []).find(function(e) { return e.id === eventId; });
      if (!event) return;

      lastActiveElement = document.activeElement;

      const modalBackdrop = document.getElementById("event-modal-backdrop");
      const imageHolder = document.getElementById("modal-image-holder");
      const badgesHolder = document.getElementById("modal-badges-holder");
      const titleElem = document.getElementById("modal-event-title");
      const gridHolder = document.getElementById("modal-grid-holder");
      const descElem = document.getElementById("modal-event-desc");
      const actionsHolder = document.getElementById("modal-actions-holder");

      imageHolder.innerHTML = event.image ? 
        '<img class="modal-header-img" src="' + event.image + '" alt="' + event.title + '">' :
        getEventArtwork(event.category, event.title);

      badgesHolder.innerHTML = '<span class="category-tag">' + (event.category || "Event") + '</span>' + renderStatusBadge(event.status);
      titleElem.textContent = event.title;
      descElem.textContent = event.longDescription || event.description;

      const formattedDate = event.dateDisplay || formatReadableDate(event.date, event.dateDisplay);
      gridHolder.innerHTML = 
        '<div class="event-info-item">' + svgIcon("calendar", "event-info-icon") + '<span><strong>Date:</strong> ' + formattedDate + '</span></div>' +
        '<div class="event-info-item">' + svgIcon("clock", "event-info-icon") + '<span><strong>Time:</strong> ' + (event.time || "TBA") + '</span></div>' +
        '<div class="event-info-item">' + svgIcon("pin", "event-info-icon") + '<span><strong>Venue:</strong> ' + (event.location || "TBA") + '</span></div>' +
        (event.bookingText ? '<div class="event-info-item">' + svgIcon("phone", "event-info-icon") + '<span><strong>Booking Hotline:</strong> ' + event.bookingText + '</span></div>' : '');

      actionsHolder.innerHTML = 
        '<a class="btn btn-primary" href="' + getGoogleCalendarUrl(event) + '" target="_blank" rel="noopener">' + svgIcon("calendar") + '<span>Add to Google Calendar</span></a>' +
        '<button type="button" class="btn btn-secondary-action" id="modal-ics-btn">' + svgIcon("download") + '<span>Download .ics</span></button>' +
        (event.mapUrl ? '<a class="btn btn-secondary-action" href="' + event.mapUrl + '" target="_blank" rel="noopener">' + svgIcon("pin") + '<span>Directions</span></a>' : '');

      document.getElementById("modal-ics-btn").onclick = function() {
        downloadIcsCalendar(event);
      };

      modalBackdrop.classList.add("open");
      document.body.style.overflow = "hidden";
      document.getElementById("modal-close-btn").focus();
    }

    function closeEventModal() {
      const modalBackdrop = document.getElementById("event-modal-backdrop");
      modalBackdrop.classList.remove("open");
      document.body.style.overflow = "";
      if (lastActiveElement && typeof lastActiveElement.focus === "function") {
        lastActiveElement.focus();
      }
    }

    function bindEventsLogic() {
      // Category filter clicks
      const filterBtns = document.querySelectorAll(".category-filter-btn");
      filterBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
          currentCategoryFilter = btn.getAttribute("data-cat");
          document.getElementById("events-mount").innerHTML = renderEventsSection();
          bindEventsLogic();
        });
      });

      // View details modal buttons
      const detailBtns = document.querySelectorAll(".btn-open-modal");
      detailBtns.forEach(function(btn) {
        btn.addEventListener("click", function(e) {
          e.stopPropagation();
          const id = btn.getAttribute("data-event-id");
          openEventModal(id);
        });
      });

      // Past events toggle
      const pastToggleBtn = document.getElementById("past-events-toggle-btn");
      if (pastToggleBtn) {
        pastToggleBtn.addEventListener("click", function() {
          const list = document.getElementById("past-events-container");
          const isExpanded = list.classList.toggle("active");
          pastToggleBtn.setAttribute("aria-expanded", String(isExpanded));
        });
      }
    }

    // Modal close events
    document.getElementById("modal-close-btn").addEventListener("click", closeEventModal);
    document.getElementById("event-modal-backdrop").addEventListener("click", function(e) {
      if (e.target === this) closeEventModal();
    });

    // Keyboard navigation (Escape closes modals)
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        closeEventModal();
      }
    });

    /* ====================================================================
       Progressive Web App (PWA) Implementation
       - Service Worker Registration
       - Offline Connectivity Banner
    ==================================================================== */
    function initPwa() {
      // Register Service Worker from sw.js
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function() {
          navigator.serviceWorker.register("./sw.js", { scope: "./" })
            .then(function(reg) {
              console.info("[PWA] Service Worker registered with scope:", reg.scope);
            })
            .catch(function(err) {
              console.warn("[PWA] Service Worker registration failed:", err);
            });
        });
      }

      // Offline status banner listener
      const offlineToast = document.getElementById("offline-toast");
      function updateOnlineStatus() {
        if (!navigator.onLine) {
          offlineToast.classList.add("visible");
        } else {
          offlineToast.classList.remove("visible");
        }
      }
      window.addEventListener("online", updateOnlineStatus);
      window.addEventListener("offline", updateOnlineStatus);
      updateOnlineStatus();
    }

    // Initialize application
    mountApp();
    initPwa();

  })();
  </script>
</body>
</html>
