<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  
  <!-- Site Title & SEO Meta Tags (Dynamically synchronized with CONFIG) -->
  <title>Dr. Rajneesh Kant | Back to Nature Spine Clinic & Events Hub</title>
  <meta name="description" content="Official link-in-bio & upcoming events portal for Dr. Rajneesh Kant at Back to Nature Spine Clinic. Book appointments, join spine health workshops, and connect on WhatsApp.">
  <meta name="theme-color" content="#0f766e">
  <meta name="robots" content="index, follow">

  <!-- PWA & Mobile Web App Meta -->
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="icon" type="image/png" href="assets/favicon.png">
  <link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Dr. Kant Hub">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="Dr. Rajneesh Kant | Back to Nature Spine Clinic & Events Hub">
  <meta property="og:description" content="All-in-one link hub and upcoming spine wellness workshops and clinics with Dr. Rajneesh Kant.">
  <meta property="og:image" content="assets/icon-512.png">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Dr. Rajneesh Kant | Back to Nature Spine Clinic & Events Hub">
  <meta name="twitter:description" content="All-in-one link hub and upcoming spine wellness workshops and clinics with Dr. Rajneesh Kant.">
  <meta name="twitter:image" content="assets/icon-512.png">

  <!-- Google Fonts: Josefin Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

  <style>
    /* ====================================================================
       CSS Reset & CSS Custom Properties (Theming driven by CONFIG)
    ==================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* ====================================================================
       Overflow Safety Net
       Guarantees no horizontal scrolling at any viewport width.
       `clip` is used ahead of `hidden` because `hidden` would turn the
       element into a scroll container and break `position: sticky`.
    ==================================================================== */
    html {
      max-width: 100%;
      overflow-x: hidden;
      overflow-x: clip;
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }

    body {
      max-width: 100%;
      overflow-x: hidden;
      overflow-x: clip;
    }

    /* Responsive media & icons: never exceed their container */
    img, svg, video {
      max-width: 100%;
    }
    img {
      height: auto;
    }

    /* Long unbroken strings (phone lists, addresses, URLs) must wrap */
    h1, h2, h3, h4, h5, h6, p, span, div, li, a, button {
      overflow-wrap: break-word;
    }

    :root {
      --primary: #0f766e;
      --primary-hover: #115e59;
      --primary-light: #ccfbf1;
      --secondary: #0284c7;
      --accent: #d97706;
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-subtle: #f1f5f9;
      --border: #e2e8f0;
      --border-focus: #0f766e;
      --text: #0f172a;
      --text-muted: #64748b;
      --text-light: #94a3b8;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 20px;
      --radius-full: 9999px;
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
      --font: 'Josefin Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);

      /* ---------------------------------------------------------------
         Fluid spacing & sizing tokens.
         These replace most media queries: components scale smoothly
         with the viewport instead of jumping between fixed breakpoints.
      ---------------------------------------------------------------- */
      --gap-section: clamp(16px, 2.2vw, 24px);
      --pad-card: clamp(16px, 2vw, 24px);
      --pad-block: clamp(14px, 1.8vw, 20px);
      --pad-page-x: clamp(12px, 3.5vw, 32px);
      --touch-min: 44px;

      /* Profile hero. Portrait and banner are both fluid, so the header
         scales continuously from 320px to 1440px with no fixed height
         anywhere: --banner-min is a floor the banner may grow past, never
         a lock. It is always comfortably larger than the portrait's overlap
         margin, which is what guarantees the portrait is never clipped by
         the card's top edge.

         --avatar-overlap stays a calc() on --avatar-size so the overlap
         stays proportional whenever the portrait is rescaled (including
         the compact landscape tokens further down). */
      --avatar-size: clamp(72px, 12vw, 120px);
      --banner-min: clamp(96px, 16vw, 200px);
      --avatar-overlap: calc(var(--avatar-size) * -0.52);

      /* Safe-area insets (notches / home indicator). `env()` resolves to
         0 on devices without cutouts, so this is safe everywhere. */
      --sat: env(safe-area-inset-top, 0px);
      --sab: env(safe-area-inset-bottom, 0px);
      --sal: env(safe-area-inset-left, 0px);
      --sar: env(safe-area-inset-right, 0px);
    }

    body {
      font-family: var(--font);
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      padding-left: max(var(--pad-page-x), var(--sal));
      padding-right: max(var(--pad-page-x), var(--sar));
      padding-top: 0;
      padding-bottom: calc(48px + var(--sab));
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }

    /* Accessibility Focus Outline */
    :focus-visible {
      outline: 2px solid var(--border-focus);
      outline-offset: 2px;
    }

    /* Keyboard-only skip link. Hidden off-screen until focused; its height is
       driven by padding rather than a min-height because it is never a
       pointer target (it appears only via Tab / keyboard focus). */
    .skip-link {
      position: absolute;
      top: -60px;
      left: 16px;
      background: var(--primary);
      color: #fff;
      padding: 10px 16px;
      border-radius: var(--radius-sm);
      font-size: 14px;
      font-weight: 600;
      z-index: 1000;
      transition: top 0.2s;
    }
    .skip-link:focus {
      top: calc(16px + var(--sat));
    }

    /* ====================================================================
       Layout Container
       Mobile-first single column. Content stays centred and constrained at
       every size so it never stretches to an uncomfortably wide measure.

         <= 599px  Mobile / folded phone ....... 100% width
         600-767   Unfolded foldable / small tab 600px
         768-1023  Tablet / fold landscape .... 860px
         >= 1024   Desktop .................... 1200px (capped, incl. 1440+)
    ==================================================================== */
    .app-container {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: var(--gap-section);
    }

    @media (min-width: 600px) {
      .app-container {
        max-width: 600px;
      }
    }

    @media (min-width: 768px) {
      .app-container {
        max-width: 860px;
      }
    }

    @media (min-width: 1024px) {
      .app-container {
        max-width: 1200px;
      }
    }

    /* Main content stack. Defined here rather than inline so the desktop
       2-column flow below can override it cleanly. */
    #main-content {
      display: flex;
      flex-direction: column;
      gap: var(--gap-section);
      min-width: 0;
    }

    /* ====================================================================
       Header & Profile Section
    ==================================================================== */
    .profile-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      /* `clip` rather than `hidden`: it still trims the banner to the
         rounded corners but can never turn the card into a scroll
         container, so it cannot mask a layout bug the way `hidden`
         would. No content is hidden by it - every descendant below is
         width-constrained and wraps, so nothing can reach these edges. */
      overflow: clip;
      box-shadow: var(--shadow-sm);
      margin-top: 16px;
      min-width: 0;
      max-width: 100%;
    }

    /* Decorative cover strip. There is deliberately no `height` here at
       all: --banner-min is a floor the banner may grow past, and the
       portrait's overlap margin is always smaller than it, so the
       portrait can never be cut off by the top of the card. */
    .profile-banner {
      width: 100%;
      min-height: var(--banner-min);
      height: auto;
      background-image: url('assets/banner.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      position: relative;
      overflow: visible;
      max-width: 100%;
    }

    .profile-banner-pattern {
      position: absolute;
      inset: 0;
      opacity: 0.12;
      background-image: radial-gradient(#fff 1.5px, transparent 1.5px);
      background-size: 16px 16px;
    }

    /* Single content box: banner + content are already capped at the
       1200px app-container width, so 1200px here is a belt-and-braces
       ceiling rather than the primary constraint. padding-block-start
       stays 0 on purpose: the portrait overlaps the banner via
       .profile-header's negative margin, which is what makes this read as
       one LinkedIn-style header instead of a banner plus a separate card. */
    .profile-content {
      width: 100%;
      max-width: 1200px;
      margin-inline: auto;
      padding: 0 clamp(16px, 4vw, 40px) clamp(20px, 3vw, 28px);
      text-align: center;
      position: relative;
      min-width: 0;
    }

    /* The portrait + text block, treated as one unit so the overlap
       shift behaves identically in the stacked and horizontal layouts.
       Stacked and centred by default; the responsive layer flips it to a
       horizontal row from 768px up. */
    .profile-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
      margin-top: var(--avatar-overlap);
      min-width: 0;
      max-width: 100%;
    }

    .profile-avatar {
      display: flex;
      flex-shrink: 0;
      max-width: 100%;
    }

    .profile-image, .profile-image-fallback {
      width: var(--avatar-size);
      height: var(--avatar-size);
      max-width: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--surface);
      box-shadow: var(--shadow-md);
      background: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: clamp(22px, 3.4vw, 34px);
      font-weight: 700;
      letter-spacing: -0.5px;
      flex-shrink: 0;
    }

    /* The text half of the header row. `min-width: 0` is what stops a long
       word from forcing this flex item (and therefore the whole row, and
       therefore the card) wider than the viewport. */
    .profile-info {
      min-width: 0;
      max-width: 100%;
      flex: 1 1 auto;
      align-self: stretch;
    }

    .profile-name {
      font-size: clamp(22px, 4vw, 32px);
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.5px;
      line-height: 1.2;
      text-wrap: balance;
      white-space: normal;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .profile-subtitle {
      font-size: clamp(15px, 2.5vw, 20px);
      font-weight: 600;
      color: var(--primary);
      margin-top: 4px;
      line-height: 1.35;
      white-space: normal;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .verified-badge {
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: 5px;
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      margin-top: 12px;
      max-width: 100%;
      text-align: center;
    }

    /* Keep the tick from being squeezed onto its own line when the badge
       wraps on a very narrow screen. */
    .verified-badge svg {
      flex-shrink: 0;
    }

    .profile-description {
      font-size: clamp(13px, 2vw, 16px);
      color: var(--text-muted);
      margin-top: 12px;
      line-height: 1.6;
      max-width: min(68ch, 100%);
      margin-inline: auto;
      text-align: center;
      white-space: normal;
      /* `anywhere` (not just the global `break-word`) also shrinks the
         min-content width, so even an unbreakable string cannot force
         this paragraph - or its flex ancestors - past the viewport. */
      overflow-wrap: anywhere;
      word-break: normal;
      min-width: 0;
    }

    /* ====================================================================
       Primary CTAs
    ==================================================================== */
    .cta-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      min-height: var(--touch-min);
      border-radius: var(--radius-md);
      font-size: 14px;
      font-weight: 600;
      transition: var(--transition);
      text-align: center;
      max-width: 100%;
    }

    .btn > svg {
      flex-shrink: 0;
    }

    .btn > span {
      min-width: 0;
      overflow-wrap: break-word;
    }

    .btn-primary {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 4px rgba(15, 118, 110, 0.2);
    }

    .btn-outline {
      background: var(--surface);
      color: var(--primary);
      border: 1.5px solid var(--primary);
    }

    .btn-whatsapp {
      background: #25d366;
      color: #ffffff;
      box-shadow: 0 2px 4px rgba(37, 211, 102, 0.25);
    }

    /* ====================================================================
       Section Card Styles
    ==================================================================== */
    .section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: var(--pad-card);
      box-shadow: var(--shadow-sm);
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--gap-section);
      flex-wrap: wrap;
      gap: 8px;
    }

    .section-title {
      font-size: clamp(17px, 4.4vw, 20px);
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      letter-spacing: -0.3px;
      min-width: 0;
    }

    .section-title > svg {
      flex-shrink: 0;
    }

    .section-subtitle {
      font-size: 13px;
      color: var(--text-muted);
    }

    /* ====================================================================
       NEW & UPCOMING EVENTS SECTION
    ==================================================================== */
    .events-controls {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .category-filter-btn {
      padding: 6px 12px;
      min-height: var(--touch-min);
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
    }

    .category-filter-btn.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    /* Featured Event Card */
    .featured-event-container {
      margin-bottom: 18px;
    }

    .featured-event-card {
      border: 2px solid var(--primary);
      border-radius: var(--radius-lg);
      background: linear-gradient(to bottom, #f0fdfa, var(--surface));
      overflow: hidden;
      box-shadow: var(--shadow-md);
      position: relative;
      transition: var(--transition);
    }

    .featured-banner-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--primary);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-sm);
      z-index: 2;
    }

    .featured-image-wrapper {
      width: 100%;
      height: clamp(140px, 32vw, 200px);
      background: #0f766e;
      position: relative;
      overflow: hidden;
    }

    .featured-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .featured-body {
      padding: var(--pad-block);
    }

    .event-meta-badges {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .category-tag {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--primary);
      background: var(--primary-light);
      padding: 3px 8px;
      border-radius: var(--radius-sm);
    }

    /* Status Badges */
    .status-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .status-upcoming {
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #bbf7d0;
    }
    .status-live {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }
    .status-live .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #ef4444;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .status-completed {
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #cbd5e1;
    }
    .status-coming-soon {
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
      font-weight: 700;
    }
    .status-cancelled {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fee2e2;
    }

    .featured-title {
      font-size: clamp(18px, 4.8vw, 22px);
      font-weight: 700;
      color: var(--text);
      line-height: 1.3;
      margin-bottom: 8px;
      text-wrap: balance;
    }

    .featured-desc {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .event-info-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 13px;
      color: var(--text);
      margin-bottom: var(--gap-section);
    }

    .event-info-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .event-info-item > span {
      min-width: 0;
      overflow-wrap: break-word;
    }

    .event-info-icon {
      color: var(--primary);
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .featured-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Standard Events Grid
       Single column on phones. Two columns from 640px up, EXCEPT while the
       page is in the >=1024px two-column section flow - there each section is
       only ~590px wide, which would squeeze event cards to ~280px, so the
       grid stays single column until the section columns get wide enough. */
    .events-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--gap-section);
    }

    @media (min-width: 640px) {
      .events-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .events-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (min-width: 1280px) {
      .events-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .event-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--transition);
      box-shadow: var(--shadow-sm);
    }

    .event-thumbnail-box {
      width: 100%;
      height: clamp(120px, 30vw, 160px);
      background: var(--surface-subtle);
      position: relative;
      overflow: hidden;
    }

    .event-thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .event-card-body {
      padding: var(--pad-block);
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
    }

    .event-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.35;
      margin-bottom: 6px;
    }

    .event-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .event-card-actions {
      margin-top: auto;
      display: flex;
      align-items: stretch;
      gap: 8px;
      flex-wrap: wrap;
    }

    .event-card-actions .btn {
      flex: 1 1 auto;
      padding: 9px 12px;
      font-size: 13px;
      min-width: 0;
    }

    .btn-secondary-action {
      background: var(--surface-subtle);
      color: var(--text);
      border: 1px solid var(--border);
    }

    /* Past Events Toggle */
    .past-events-wrapper {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px dashed var(--border);
    }

    .past-events-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      min-height: var(--touch-min);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      padding: 6px 0;
      text-align: left;
    }

    .past-events-list {
      margin-top: 12px;
      display: none;
      flex-direction: column;
      gap: 10px;
    }
    .past-events-list.active {
      display: flex;
    }

    .past-event-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px 12px;
      padding: 10px 14px;
      background: var(--surface-subtle);
      border-radius: var(--radius-md);
      font-size: 13px;
    }

    .past-event-row > div {
      min-width: 0;
      flex: 1 1 180px;
    }

    .past-event-title {
      font-weight: 600;
      color: var(--text);
    }

    .past-event-date {
      color: var(--text-muted);
      font-size: 12px;
    }

    /* Empty state */
    .events-empty {
      text-align: center;
      padding: 32px 16px;
      color: var(--text-muted);
      font-size: 14px;
    }

    /* ====================================================================
       Links Card & List Items
    ==================================================================== */
    .links-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .link-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      min-height: var(--touch-min);
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      transition: var(--transition);
      cursor: pointer;
    }

    .link-icon-box {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
      background: #ffffff;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      flex-shrink: 0;
      box-shadow: var(--shadow-sm);
    }

    .link-text {
      flex: 1;
      min-width: 0;
    }

    /* Titles & subtitles wrap to at most 2 lines on phones so long values
       (e.g. "+91 97410 39910 • Oct 10, 11, 12 Appointments") stay readable.
       The single-line ellipsis is restored from 600px up, where there is
       enough width to show everything on one line. */
    .link-title,
    .link-subtitle {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      overflow-wrap: break-word;
    }

    .link-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .link-subtitle {
      font-size: 12px;
      color: var(--text-muted);
    }

    .link-arrow {
      color: var(--text-light);
      transition: var(--transition);
      flex-shrink: 0;
    }

    @media (min-width: 600px) {
      .link-title,
      .link-subtitle {
        display: block;
        white-space: nowrap;
        text-overflow: ellipsis;
      }
    }

    /* ====================================================================
       Patient App Card
    ==================================================================== */
    .app-card {
      background: linear-gradient(135deg, #042f2e 0%, #0f766e 100%);
      color: #ffffff;
      border-radius: var(--radius-lg);
      padding: var(--pad-card);
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: var(--shadow-md);
    }

    .app-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.15);
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      width: fit-content;
      backdrop-filter: blur(4px);
    }

    .app-title {
      font-size: clamp(18px, 4.6vw, 20px);
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .app-desc {
      font-size: 13px;
      color: #ccfbf1;
      line-height: 1.5;
    }

    .app-actions {
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .playstore-btn {
      display: inline-flex;
      align-items: center;
      max-width: 100%;
      background: #000000;
      color: #ffffff;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      transition: var(--transition);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* The Play badge is an inline SVG with hardcoded width/height attributes;
       these rules let it shrink on the narrowest screens instead of forcing
       the card wider than the viewport. */
    .playstore-btn svg {
      max-width: 100%;
      height: auto;
    }

    /* ====================================================================
       Google Reviews Card
    ==================================================================== */
    .reviews-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
      background: var(--surface-subtle);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .reviews-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px 12px;
    }

    .reviews-rating-big {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px;
    }

    .rating-number {
      font-size: 26px;
      font-weight: 800;
      color: var(--text);
    }

    .rating-out-of {
      font-size: 13px;
      color: var(--text-muted);
    }

    .star-row {
      display: flex;
      align-items: center;
      gap: 2px;
      color: #f59e0b;
    }

    .branch-reviews-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(130px, 100%), 1fr));
      gap: 8px;
      padding-top: 10px;
      border-top: 1px solid var(--border);
    }

    .branch-review-item {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 8px 12px;
      min-height: var(--touch-min);
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      transition: var(--transition);
    }

    .branch-review-name {
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
    }
    .branch-review-score {
      font-size: 12px;
      color: #d97706;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* ====================================================================
       Clinic Locations
    ==================================================================== */
    .branch-card {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 14px;
      margin-bottom: 12px;
    }
    .branch-card:last-child {
      margin-bottom: 0;
    }

    .branch-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 8px;
    }

    .branch-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
      min-width: 0;
    }

    .branch-details-row {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 6px;
    }

    /* Addresses and multi-number phone strings must wrap, not overflow. */
    .branch-details-row > span {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    /* Phone links are inline text within the row; give them a full-height
       tap target without disturbing the surrounding text layout. */
    .branch-details-row > a {
      min-width: 0;
      min-height: var(--touch-min);
      display: inline-flex;
      align-items: center;
      overflow-wrap: anywhere;
    }

    .branch-details-row svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      margin-top: 3px;
      color: var(--primary);
    }

    .branch-actions {
      margin-top: 10px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-sm {
      padding: 6px 12px;
      min-height: var(--touch-min);
      font-size: 12px;
      font-weight: 600;
      border-radius: var(--radius-sm);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      max-width: 100%;
      text-align: center;
    }

    .btn-sm > svg {
      flex-shrink: 0;
    }

    /* ====================================================================
       Social Media Row
    ==================================================================== */
    .social-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .social-btn {
      width: var(--touch-min);
      height: var(--touch-min);
      min-width: var(--touch-min);
      border-radius: 50%;
      background: var(--surface);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }

    /* ====================================================================
       Footer
    ==================================================================== */
    .footer {
      text-align: center;
      padding: clamp(20px, 3vw, 28px) 0 12px;
      color: var(--text-muted);
      font-size: 12px;
      overflow-wrap: break-word;
    }

    /* ====================================================================
       Modal (Event Details & iOS PWA Guide)
    ==================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      padding-top: max(16px, var(--sat));
      padding-bottom: max(16px, var(--sab));
      padding-left: max(16px, var(--sal));
      padding-right: max(16px, var(--sar));
      z-index: 999;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .modal-backdrop.open {
      display: flex;
      opacity: 1;
    }

    .modal-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      max-width: 520px;
      width: 100%;
      /* `dvh` tracks the viewport as mobile browser chrome collapses or
         expands, which `vh` does not. The `vh` line stays as a fallback. */
      max-height: 90vh;
      max-height: 90dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      box-shadow: var(--shadow-xl);
      position: relative;
      animation: modalSlide 0.25s ease-out;
    }

    @keyframes modalSlide {
      from { transform: translateY(16px) scale(0.98); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    .modal-header-visual {
      width: 100%;
      height: clamp(140px, 30vw, 190px);
      background: #0f766e;
      position: relative;
    }

    .modal-header-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .modal-close-btn {
      position: absolute;
      top: max(12px, calc(var(--sat) * 0.5));
      right: max(12px, var(--sar));
      width: var(--touch-min);
      height: var(--touch-min);
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.5);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
      transition: var(--transition);
      z-index: 5;
    }

    .modal-content {
      padding: var(--pad-card);
    }

    .modal-title {
      font-size: clamp(18px, 4.8vw, 22px);
      font-weight: 700;
      color: var(--text);
      line-height: 1.3;
      margin-top: 8px;
      margin-bottom: 12px;
      text-wrap: balance;
    }

    .modal-description {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.6;
      margin: 16px 0;
      white-space: pre-line;
      overflow-wrap: break-word;
    }

    .modal-details-grid {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--pad-block);
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .modal-details-grid .event-info-item {
      align-items: flex-start;
    }

    .modal-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .modal-actions .btn {
      flex: 1 1 180px;
    }

    /* Offline Toast */
    .offline-toast {
      position: fixed;
      bottom: calc(20px + var(--sab));
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #1e293b;
      color: #ffffff;
      padding: 10px 18px;
      max-width: calc(100% - 32px - var(--sal) - var(--sar));
      text-align: center;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-lg);
      font-size: 13px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 1000;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
    }

    .offline-toast.visible {
      transform: translateX(-50%) translateY(0);
    }

    .offline-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #f59e0b;
      flex-shrink: 0;
    }

    /* ====================================================================
       RESPONSIVE LAYER
       Ordered narrowest-first. Component-level scaling is handled by the
       clamp() tokens defined in :root; these blocks cover the structural
       changes that fluid tokens cannot express.
    ==================================================================== */

    /* --------------------------------------------------------------------
       Small Mobile: <= 374px (320px, 360px, 374px devices)
       Single column throughout. Compact hero and typography, full-width
       action buttons, and every card guaranteed to fit the viewport.

       No portrait/banner overrides are needed here: --avatar-size and
       --banner-min are fluid, so they already bottom out at 72px and 96px
       across this whole range - more compact than the fixed values they
       replace, and still free to grow if the text ever needs more room.
    --------------------------------------------------------------------- */
    @media (max-width: 374px) {
      :root {
        --pad-card: 15px;
        --pad-block: 13px;
        --gap-section: 14px;
      }

      .profile-card {
        margin-top: 12px;
      }

      .profile-header {
        gap: 10px;
      }

      .profile-description {
        margin-top: 10px;
      }

      .featured-actions,
      .branch-actions,
      .app-actions,
      .modal-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .featured-actions .btn,
      .modal-actions .btn {
        flex: 1 1 auto;
        width: 100%;
      }

      .branch-actions .btn-sm,
      .branch-actions .btn {
        flex: 1 1 auto;
      }

      /* Let the Play badge scale down rather than push the card wide. */
      .playstore-btn {
        padding: 8px 12px;
      }

      .events-empty {
        padding: 24px 12px;
      }

      .link-item {
        padding: 12px;
        gap: 12px;
      }
    }

    /* --------------------------------------------------------------------
       Unfolded Foldable / Small Tablet: 600px - 767px
       The wider viewport is used for breathing room rather than for
       stretching content. Primary link lists stay single column: two
       columns of link rows would be no more tappable than one full-width
       column, and would truncate the longer titles.

       The profile header stays stacked and centred here. .app-container
       is already capped at 600px, so the description can never stretch
       across an unfolded screen - the extra width only buys spacing.
    --------------------------------------------------------------------- */
    @media (min-width: 600px) {
      .section {
        padding: clamp(20px, 3vw, 24px);
      }

      .profile-header {
        gap: 14px;
      }

      .profile-description {
        max-width: min(62ch, 100%);
        margin-top: 14px;
      }
    }

    /* --------------------------------------------------------------------
       Tablet / Fold Landscape: 768px - 1023px
       Centred container (already capped at 860px). Suitable card groups
       expand to two columns while touch targets grow slightly.

       This is also where the profile header switches from the compact
       stacked mobile form to the traditional LinkedIn arrangement:
       portrait on the left, name/clinic/badge beside it, description on
       its own lines underneath. .profile-info carries min-width: 0 so a
       long word can never widen the row past the container.
    --------------------------------------------------------------------- */
    @media (min-width: 768px) {
      .section {
        padding: 24px;
      }

      .profile-header {
        flex-direction: row;
        align-items: center;
        gap: 20px;
        text-align: left;
      }

      .profile-info {
        align-self: center;
        text-align: left;
      }

      .verified-badge {
        justify-content: flex-start;
      }

      .profile-description {
        text-align: left;
        margin-inline: 0 auto;
        margin-top: 14px;
      }

      .cta-row {
        gap: 12px;
      }

      .btn {
        padding: 13px 22px;
        font-size: 15px;
      }

      .link-item {
        padding: 16px 18px;
      }

      .branch-card {
        padding: 16px;
      }

      .reviews-card {
        padding: 18px;
      }
    }

    /* --------------------------------------------------------------------
       Desktop: >= 1024px  (capped at 1200px, unchanged at 1440px+)
       The 8 content sections become a genuine two-column layout. This uses
       CSS multi-column rather than grid rows because section heights range
       from ~70px (CTA row) to ~1100px (events): grid rows would leave large
       ragged gaps, while multi-column balances the two columns itself.

       `break-inside: avoid` keeps each card whole, and because multi-column
       flows in document order, visual order still matches DOM and tab order.
       The profile header and footer sit outside #main-content, so they stay
       full-bleed at 1200px.
    --------------------------------------------------------------------- */
    @media (min-width: 1024px) {
      #main-content {
        display: block;
        column-count: 2;
        column-gap: clamp(20px, 2vw, 28px);
      }

      #main-content > * {
        break-inside: avoid;
        -webkit-column-break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: var(--gap-section);
      }

      /* Extra vertical rhythm now that there is room to spare. */
      .section {
        padding: 24px;
      }
    }

    /* Wider section columns make a 2-column events grid viable again. */
    @media (min-width: 1280px) {
      #main-content {
        column-gap: 28px;
      }
    }

    /* --------------------------------------------------------------------
       Landscape phones (e.g. 812x375, 667x375) and any short viewport.
       The hero would otherwise eat half the visible height.

       These are still clamps, not fixed heights: a landscape viewport
       that is both short and wide still gets a banner that scales with
       it, and --avatar-overlap recomputes automatically because it is a
       calc() on --avatar-size. The overrides come last in the file, so
       they win over both --avatar-size/--banner-min and the >= 600px
       block above.
    --------------------------------------------------------------------- */
    @media (orientation: landscape) and (max-height: 500px) {
      :root {
        --avatar-size: clamp(64px, 10vw, 88px);
        --banner-min: clamp(72px, 13vw, 110px);
      }

      .profile-card {
        margin-top: 10px;
      }

      .featured-image-wrapper {
        height: 120px;
      }

      .event-thumbnail-box {
        height: 110px;
      }

      .modal-header-visual {
        height: 120px;
      }

      .events-empty {
        padding: 20px 12px;
      }
    }

    /* --------------------------------------------------------------------
       Pointer & motion preferences
       Hover styles are only applied on devices with a real pointer. Without
       this, touch devices keep the :hover state stuck after a tap.
    --------------------------------------------------------------------- */
    @media (hover: hover) and (pointer: fine) {
      .btn-primary:hover {
        background: var(--primary-hover);
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(15, 118, 110, 0.3);
      }

      .btn-outline:hover {
        background: var(--primary-light);
        transform: translateY(-1px);
      }

      .btn-whatsapp:hover {
        background: #20ba5a;
        transform: translateY(-1px);
      }

      .category-filter-btn:hover {
        color: var(--text);
        background: #e2e8f0;
      }

      .featured-event-card:hover {
        box-shadow: var(--shadow-lg);
      }

      .event-card:hover {
        border-color: #cbd5e1;
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
      }

      .btn-secondary-action:hover {
        background: #e2e8f0;
      }

      .past-events-toggle:hover {
        color: var(--text);
      }

      .link-item:hover {
        background: #ffffff;
        border-color: #cbd5e1;
        transform: translateY(-1px);
        box-shadow: var(--shadow-sm);
      }

      .link-item:hover .link-arrow {
        color: var(--primary);
        transform: translateX(3px);
      }

      .playstore-btn:hover {
        background: #1e293b;
        transform: translateY(-1px);
      }

      .branch-review-item:hover {
        border-color: var(--primary);
      }

      .social-btn:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
      }

      .social-btn[data-brand="instagram"]:hover { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); border-color: transparent; }
      .social-btn[data-brand="youtube"]:hover { background: #ff0000; border-color: #ff0000; }
      .social-btn[data-brand="facebook"]:hover { background: #1877f2; border-color: #1877f2; }
      .social-btn[data-brand="whatsapp"]:hover { background: #25d366; border-color: #25d366; }

      .modal-close-btn:hover {
        background: rgba(0, 0, 0, 0.8);
        transform: scale(1.05);
      }
    }

    /* Touch devices get a visible pressed state instead. */
    @media (hover: none) {
      .btn:active,
      .btn-sm:active,
      .category-filter-btn:active,
      .link-item:active,
      .branch-review-item:active,
      .social-btn:active,
      .branch-actions .btn:active,
      .past-events-toggle:active {
        transform: scale(0.98);
        opacity: 0.85;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }

      .status-live .pulse-dot {
        animation: none;
      }
    }
  </style>
</head>
<body>

  <!-- Accessible Skip Navigation Link -->
  <a class="skip-link" href="#main-content">Skip to content</a>

  <!-- Main Application Container -->
  <div class="app-container">

    <!-- Header / Profile Mount Point -->
    <header id="profile-mount"></header>

    <!-- Main Content Area -->
    <main id="main-content">
      
      <!-- Primary CTAs Mount Point -->
      <div id="cta-mount"></div>

      <!-- NEW & UPCOMING EVENTS SECTION Mount Point -->
      <div id="events-mount"></div>

      <!-- Quick WhatsApp Branches Mount Point -->
      <div id="whatsapp-mount"></div>

      <!-- Main Resources & Links Mount Point -->
      <div id="links-mount"></div>

      <!-- Google Reviews Mount Point -->
      <div id="reviews-mount"></div>

      <!-- Patient Mobile App Card Mount Point -->
      <div id="app-mount"></div>

      <!-- Clinic Branches & Directions Mount Point -->
      <div id="clinic-mount"></div>

      <!-- Social Channels Mount Point -->
      <div id="socials-mount"></div>

    </main>

    <!-- Footer Mount Point -->
    <footer id="footer-mount"></footer>

  </div>

  <!-- Event Details Interactive Modal -->
