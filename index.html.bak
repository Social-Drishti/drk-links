      '</svg>';

    /* Helper: Format ISO date string into readable text */
    function formatReadableDate(dateStr, dateDisplay) {
      if (dateDisplay) return dateDisplay;
      if (!dateStr) return "";
      try {
        const parts = dateStr.split("-");
        if (parts.length === 3) {
          const d = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
          return d.toLocaleDateString("en-IN", {
            weekday: "short",
            day: "numeric",
            month: "short",
            year: "numeric"
          });
        }
      } catch (e) {
        return dateStr;
      }
      return dateStr;
    }

    /* Helper: Generate stylized gradient illustration for events */
    function getEventArtwork(category, title) {
      const cat = (category || "").toLowerCase();
      const t = (title || "").toLowerCase();
      let grad = "linear-gradient(135deg, #0f766e 0%, #042f2e 100%)";
      let icon = "calendar";
      if (cat.includes("camp")) {
        grad = "linear-gradient(135deg, #0284c7 0%, #0c4a6e 100%)";
        icon = "clinic";
      } else if (cat.includes("book") || t.includes("book")) {
        grad = "linear-gradient(135deg, #2563eb 0%, #1e1b4b 100%)";
        icon = "sparkles";
      } else if (cat.includes("webinar")) {
        grad = "linear-gradient(135deg, #7c3aed 0%, #3b0764 100%)";
        icon = "globe";
      } else if (cat.includes("summit") || cat.includes("special")) {
        grad = "linear-gradient(135deg, #d97706 0%, #78350f 100%)";
        icon = "sparkles";
      }
      return '<div style="width:100%; height:100%; background:' + grad + '; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#fff; padding:16px; text-align:center; position:relative;">' +
             '<div style="opacity:0.25; position:absolute; inset:0; background-image:radial-gradient(#fff 1px, transparent 1px); background-size:12px 12px;"></div>' +
             '<div style="background:rgba(255,255,255,0.18); border-radius:50%; width:44px; height:44px; display:flex; align-items:center; justify-content:center; margin-bottom:8px; z-index:1;">' +
             svgIcon(icon) +
             '</div>' +
             '<div style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; opacity:0.9; z-index:1; max-width:100%; padding:0 4px; overflow-wrap:break-word;">' + (category || "Event") + '</div>' +
             '</div>';
    }

    /* Helper: Render Status Badge */
    function renderStatusBadge(status) {
      const st = (status || "upcoming").toLowerCase().replace(/[\s_]+/g, "-");
      if (st === "live") {
        return '<span class="status-badge status-live"><span class="pulse-dot"></span>Live Now</span>';
      } else if (st === "coming-soon") {
        return '<span class="status-badge status-coming-soon">⏳ Coming Soon</span>';
      } else if (st === "completed") {
        return '<span class="status-badge status-completed">✓ Completed</span>';
      } else if (st === "cancelled") {
        return '<span class="status-badge status-cancelled">✕ Cancelled</span>';
      }
      return '<span class="status-badge status-upcoming">● Upcoming</span>';
    }

    /* Helper: Generate 1-Tap Google Calendar URL */
    function getGoogleCalendarUrl(event) {
      if (!event) return "#";
      const title = encodeURIComponent(event.title || "Dr. Rajneesh Kant Spine Event");
      const details = encodeURIComponent(
        (event.longDescription || event.description || "") + 
        "\n\nOrganized by Dr. Rajneesh Kant | Back to Nature Spine Clinic" +
        (event.bookingText ? "\nAppointment Hotlines: " + event.bookingText : "")
      );
      const location = encodeURIComponent(event.location || "");

      let dates = "20261010T043000Z/20261012T133000Z";
      if (event.id && event.id.includes("bengaluru")) {
        // Oct 10 to Oct 12, 2026
        dates = "20261010T043000Z/20261012T133000Z";
      } else if (event.id && event.id.includes("oct14")) {
        dates = "20261014T043000Z/20261014T133000Z";
      } else if (event.id && event.id.includes("oct18")) {
        dates = "20261018T043000Z/20261018T133000Z";
      } else if (event.date) {
        const clean = event.date.replace(/-/g, "");
        dates = clean + "T043000Z/" + clean + "T133000Z";
      }
      return "https://calendar.google.com/calendar/render?action=TEMPLATE&text=" + title + "&dates=" + dates + "&details=" + details + "&location=" + location;
    }

    /* ====================================================================
       Render Header / Profile

       LinkedIn-style header. .profile-header keeps the portrait and the
       name/clinic/badge block together as one unit so the overlap shift
       behaves identically whether they are stacked (mobile) or side by
       side (>= 768px). The verified badge lives inside the text block so
       it sits directly under the clinic name at every breakpoint, and the
       description is the last child so it flows full-width underneath the
       whole row. Reading order matches visual order.
    ==================================================================== */
    function renderProfile() {
      const p = CONFIG.profile;
      const verifiedHtml = p.verified ? 
        '<div class="verified-badge">' + svgIcon("check") + '<span>' + (p.verifiedText || "Verified Clinic Profile") + '</span></div>' : '';

      return '<div class="profile-card">' +
        '<div class="profile-banner">' +
          '<div class="profile-banner-pattern"></div>' +
        '</div>' +
        '<div class="profile-content">' +
          '<div class="profile-header">' +
            '<div class="profile-avatar">' +
              (p.avatar.image ? 
                '<img class="profile-image" src="' + p.avatar.image + '" alt="' + p.avatar.alt + '" decoding="async">' :
                '<div class="profile-image-fallback">' + p.avatar.initials + '</div>') +
            '</div>' +
            '<div class="profile-info">' +
              '<h1 class="profile-name">' + p.name + '</h1>' +
              '<p class="profile-subtitle">' + p.clinic + '</p>' +
              verifiedHtml +
            '</div>' +
          '</div>' +
          '<p class="profile-description">' + p.bio + '</p>' +
        '</div>' +
      '</div>';
    }

    /* ====================================================================
       Render Primary CTAs
    ==================================================================== */
    function renderCtas() {
      const items = CONFIG.ctas.map(function(c) {
        let href = c.url || "#";
        if (c.whatsapp) {
          href = "https://wa.me/" + c.whatsapp;
        }
        let variantClass = "btn-primary";
        if (c.variant === "outline") variantClass = "btn-outline";
        if (c.variant === "whatsapp") variantClass = "btn-whatsapp";

        return '<a class="btn ' + variantClass + '" href="' + href + '" target="_blank" rel="noopener">' +
          svgIcon(c.icon || "calendar") +
          '<span>' + c.label + '</span>' +
        '</a>';
      }).join("");

      return '<div class="cta-row">' + items + '</div>';
    }

    /* ====================================================================
       Render Events Section (CONFIG-Driven with Sorting & Filters)
    ==================================================================== */
    let currentCategoryFilter = "All";

    function getProcessedEvents() {
      if (!CONFIG.events || !CONFIG.events.length) return { upcoming: [], past: [], featured: null, categories: [] };

      // Collect categories
      const catSet = new Set(["All"]);
      CONFIG.events.forEach(function(e) {
        if (e.category) catSet.add(e.category);
      });
      const categories = Array.from(catSet);

      // Sort events by date if enabled
      let list = [...CONFIG.events];
      if (CONFIG.eventSettings.sortByDate) {
        list.sort(function(a, b) {
          return (a.date || "").localeCompare(b.date || "");
        });
      }

      // Filter by category
      if (currentCategoryFilter !== "All") {
        list = list.filter(function(e) {
          return e.category === currentCategoryFilter;
        });
      }

      // Separate upcoming vs past events
      // An event is past if status === 'completed' or status === 'cancelled' OR date < today's date
      const todayIso = new Date().toISOString().split("T")[0];
      const upcoming = [];
      const past = [];
      let featured = null;

      list.forEach(function(e) {
        const isPast = e.status === "completed" || e.status === "cancelled" || (e.date && e.date < todayIso && e.status !== "live");
        if (isPast) {
          past.push(e);
        } else {
          if (e.featured && !featured) {
            featured = e;
          } else {
            upcoming.push(e);
          }
        }
      });

      return { upcoming: upcoming, past: past, featured: featured, categories: categories };
    }

    function renderEventsSection() {
      if (!CONFIG.eventSettings.showEventSection) return "";

      const data = getProcessedEvents();

      // Category filter buttons
      let filterButtonsHtml = "";
      if (CONFIG.eventSettings.filterByCategory && data.categories.length > 2) {
        filterButtonsHtml = '<div class="events-controls" role="group" aria-label="Filter events by category">' +
          data.categories.map(function(cat) {
            const activeClass = cat === currentCategoryFilter ? " active" : "";
            return '<button type="button" class="category-filter-btn' + activeClass + '" data-cat="' + cat + '">' +
              cat +
            '</button>';
          }).join("") +
        '</div>';
      }

      // Featured event HTML
      let featuredHtml = "";
      if (data.featured) {
        const f = data.featured;
        const formattedDate = f.dateDisplay || formatReadableDate(f.date, f.dateDisplay);
        featuredHtml = '<div class="featured-event-container">' +
          '<div class="featured-event-card" data-event-id="' + f.id + '">' +
            '<div class="featured-banner-tag">' + (CONFIG.eventSettings.featuredBadgeText || "⭐ FEATURED") + '</div>' +
            '<div class="featured-image-wrapper">' +
              (f.image ? '<img class="featured-image" src="' + f.image + '" alt="' + f.title + '">' : getEventArtwork(f.category, f.title)) +
            '</div>' +
            '<div class="featured-body">' +
              '<div class="event-meta-badges">' +
                '<span class="category-tag">' + (f.category || "Event") + '</span>' +
                renderStatusBadge(f.status) +
              '</div>' +
              '<h3 class="featured-title">' + f.title + '</h3>' +
              '<p class="featured-desc">' + f.description + '</p>' +
              '<div class="event-info-list">' +
                '<div class="event-info-item">' + svgIcon("calendar", "event-info-icon") + '<span>' + formattedDate + '</span></div>' +
                '<div class="event-info-item">' + svgIcon("clock", "event-info-icon") + '<span>' + (f.time || "TBA") + '</span></div>' +
                '<div class="event-info-item">' + svgIcon("pin", "event-info-icon") + '<span>' + (f.location || "TBA") + '</span></div>' +
                (f.bookingText ? '<div class="event-info-item" style="color:var(--primary); font-weight:600;">' + svgIcon("phone", "event-info-icon") + '<span>Book: ' + f.bookingText + '</span></div>' : '') +
              '</div>' +
              '<div class="featured-actions">' +
                '<a class="btn btn-primary" href="' + getGoogleCalendarUrl(f) + '" target="_blank" rel="noopener">' + svgIcon("calendar") + '<span>Add to Google Calendar</span></a>' +
                (f.detailsEnabled && CONFIG.eventSettings.enableModal ?
                  '<button type="button" class="btn btn-secondary-action btn-open-modal" data-event-id="' + f.id + '">View Details</button>' : '') +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>';
      }

      // Upcoming Grid HTML
      let cardsHtml = "";
      if (data.upcoming.length > 0) {
        cardsHtml = '<div class="events-grid">' +
          data.upcoming.map(function(ev) {
            const formattedDate = ev.dateDisplay || formatReadableDate(ev.date, ev.dateDisplay);
            return '<div class="event-card" data-event-id="' + ev.id + '">' +
              '<div class="event-thumbnail-box">' +
                (ev.image ? '<img class="event-thumbnail" src="' + ev.image + '" alt="' + ev.title + '">' : getEventArtwork(ev.category, ev.title)) +
              '</div>' +
              '<div class="event-card-body">' +
                '<div class="event-meta-badges">' +
                  '<span class="category-tag">' + (ev.category || "Event") + '</span>' +
                  renderStatusBadge(ev.status) +
                '</div>' +
                '<h4 class="event-title">' + ev.title + '</h4>' +
                '<p class="event-desc">' + ev.description + '</p>' +
                '<div class="event-info-list">' +
                  '<div class="event-info-item">' + svgIcon("calendar", "event-info-icon") + '<span>' + formattedDate + '</span></div>' +
                  '<div class="event-info-item">' + svgIcon("clock", "event-info-icon") + '<span>' + (ev.time || "TBA") + '</span></div>' +
                  '<div class="event-info-item">' + svgIcon("pin", "event-info-icon") + '<span>' + (ev.location || "TBA") + '</span></div>' +
                  (ev.bookingText ? '<div class="event-info-item" style="color:var(--primary); font-weight:600;">' + svgIcon("phone", "event-info-icon") + '<span>Book: ' + ev.bookingText + '</span></div>' : '') +
                '</div>' +
                '<div class="event-card-actions">' +
                  '<a class="btn btn-primary" href="' + getGoogleCalendarUrl(ev) + '" target="_blank" rel="noopener">' + svgIcon("calendar") + '<span>Add to Google Calendar</span></a>' +
                  (ev.detailsEnabled && CONFIG.eventSettings.enableModal ?
                    '<button type="button" class="btn btn-secondary-action btn-open-modal" data-event-id="' + ev.id + '">Details</button>' : '') +
                '</div>' +
              '</div>' +
            '</div>';
          }).join("") +
        '</div>';
      } else if (!data.featured) {
        cardsHtml = '<div class="events-empty">No upcoming events scheduled in this category. Check back soon!</div>';
      }

      // Past Events HTML
      let pastHtml = "";
      if (CONFIG.eventSettings.showPastEvents && data.past.length > 0) {
        pastHtml = '<div class="past-events-wrapper">' +
          '<button type="button" class="past-events-toggle" id="past-events-toggle-btn" aria-expanded="false">' +
            '<span>Past Events Archive (' + data.past.length + ')</span>' +
            svgIcon("chevron") +
          '</button>' +
          '<div class="past-events-list" id="past-events-container">' +
            data.past.map(function(pe) {
              const formattedDate = pe.dateDisplay || formatReadableDate(pe.date, pe.dateDisplay);
              return '<div class="past-event-row">' +
                '<div>' +
                  '<div class="past-event-title">' + pe.title + '</div>' +
                  '<div class="past-event-date">' + formattedDate + ' • ' + (pe.location || '') + '</div>' +
                '</div>' +
                renderStatusBadge(pe.status) +
              '</div>';
            }).join("") +
          '</div>' +
        '</div>';
      }

      return '<section class="section" aria-labelledby="events-section-title">' +
        '<div class="section-header">' +
          '<h2 class="section-title" id="events-section-title">' + svgIcon("calendar") + ' New & Upcoming Events</h2>' +
          '<span class="section-subtitle">' + (data.upcoming.length + (data.featured ? 1 : 0)) + ' scheduled</span>' +
        '</div>' +
        filterButtonsHtml +
        featuredHtml +
        cardsHtml +
        pastHtml +
      '</section>';
    }

    /* ====================================================================
       Render WhatsApp Links Section
    ==================================================================== */
