    /* ====================================================================
       Render Social Channels Row
    ==================================================================== */
    function renderSocials() {
      if (!CONFIG.socials || !CONFIG.socials.length) return "";

      const items = CONFIG.socials.map(function(s) {
        return '<a class="social-btn" href="' + s.url + '" target="_blank" rel="noopener" data-brand="' + s.id + '" aria-label="' + s.label + '">' +
          svgIcon(s.id) +
