          '<span class="branch-review-name">' + b.label + ' Clinic</span>' +
          '<span class="branch-review-score">' + svgIcon("star") + b.rating + ' / 5</span>' +
        '</a>';
      }).join("");

      return '<section class="section" aria-labelledby="reviews-heading">' +
        '<div class="section-header">' +
          '<h2 class="section-title" id="reviews-heading">' + GOOGLE_G_SVG + ' ' + r.label + '</h2>' +
          '<a class="btn-sm btn-outline" href="' + r.url + '" target="_blank" rel="noopener">Read Reviews</a>' +
        '</div>' +
        '<div class="reviews-card">' +
          '<div class="reviews-header">' +
