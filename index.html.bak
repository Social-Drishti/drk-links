              svgIcon("star") + svgIcon("star") + svgIcon("star") + svgIcon("star") + svgIcon("star") +
            '</div>' +
          '</div>' +
          '<div class="branch-reviews-list">' + branchItems + '</div>' +
        '</div>' +
      '</section>';
    }

    /* ====================================================================
       Render Patient Mobile App Card
    ==================================================================== */
    function renderApp() {
